# 用法：cp .env.example .env
# 然后用编辑器填入 key —— 不要在命令行里输入 key，它会进入 shell 历史
# 真实的 .env 已被 .gitignore 忽略，不会提交

# ── LLM（可选）─────────────────────────────
# 不配置也能完整运行，只是没有架构解读与 LLM 查询计划

# DeepSeek（国内直连，OpenAI 协议兼容）
OPENAI_API_KEY=sk-your-key-here
OPENAI_BASE_URL=https://api.deepseek.com/v1
REPOSURGEON_MODEL=deepseek-chat

# OpenAI 官方
# OPENAI_API_KEY=sk-your-key-here
# OPENAI_BASE_URL=
# REPOSURGEON_MODEL=gpt-4o-mini

# 智谱 GLM
# OPENAI_API_KEY=your-key-here
# OPENAI_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# REPOSURGEON_MODEL=glm-4-flash

# ── 端口（可选）────────────────────────────
# 刻意不使用通用的 PORT：容器与 CI 普遍会注入它
# REPOSURGEON_API_PORT=3100
# REPOSURGEON_WEB_PORT=5173
